# Copy this file to .env and enter the values for your environment.
OPENAI_API_KEY=
DATABASE_URL=
# Set this only when a Docker-oriented DATABASE_URL uses host.docker.internal
# but the FastAPI server itself runs directly on your computer.
DATABASE_HOST_OVERRIDE=
AUTO_CREATE_TABLES=true
DEVICE_CONTROL_KEY=
DEVICE_CONTROL_KEYS=
DEVICE_PROVISIONING_KEY=
COMMAND_ACK_TIMEOUT_SECONDS=5
COMMAND_RESULT_TIMEOUT_SECONDS=30
BOARD_HEARTBEAT_STALE_SECONDS=30
# Voice recognition: VisionNavi faster-whisper defaults suitable for CPU testing.
AUDIO_TRANSCRIPTION_MODEL=small
AUDIO_TRANSCRIPTION_DEVICE=cpu
AUDIO_TRANSCRIPTION_COMPUTE_TYPE=int8
AUDIO_TRANSCRIPTION_BEAM_SIZE=3
AUDIO_TRANSCRIPTION_VAD_FILTER=true
AUDIO_TRANSCRIPTION_INITIAL_PROMPT="스마트 제조 장비 제어 명령입니다. 장비명은 기본 컨베이어, 컨베이어, 색상분류 컨베이어, 피더, AGV입니다. 명령은 상태 확인, 시작, 정지, 비상 정지, 속도 변경, 정방향, 역방향, 색상 설정, 복귀, 적재함입니다."
